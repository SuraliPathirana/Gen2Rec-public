# --- LLM / embedding providers ---
OPENAI_API_KEY=
VOYAGE_AI_API_KEY=
# Set to 1 to use a local Llama 3 70B through Ollama instead of GPT-4o
OSS=0

# --- Vector store ---
PERSISTENT_EMBEDDINGS_PATH=local-embeddings
# Set to 1 to reuse a collection generated by the scripts in embeddings/
EMBEDDINGS_GENERATED=1
EMBEDDINGS_COLLECTION_NAME=movie

# --- Prompt templates ---
RETRIEVER_PROMPT_PATH=backend/prompts/retriever.prompt
GUARDRAILS_PROMPT_PATH=backend/prompts/guard_rails.prompt

# --- Frontend ---
GEN2REC_BACKEND_URL=http://localhost:8000

# --- Dataset collection (only needed to rebuild datasets) ---
OMDB_API_KEY=
NOTEB_API_KEY=
CHROMEDRIVER_PATH=chromedriver
